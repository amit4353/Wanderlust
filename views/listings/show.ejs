<% layout("/layouts/boilerplate") %>
<!-- Pass listing data to JS -->
<script>
  window.listingData = {
    title: "<%= listing.title %>",
    location: "<%= listing.location %>"
  };
</script>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3><%= listing.title %></h3>
    </div>
    <div class="card col-6 offset-2 listing-card">
        <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="Listing Image..">
        <div class="card-body">
            <p class="card-text">
                <p><i>Owned by : <%=listing.owner.username%></i></p>
                <p><%= listing.description %></p>
                <p>&#8377; <%= listing.price.toLocaleString("en-in") %></p>
                <p><%= listing.location %></p>
                <p><%= listing.country %></p>
            </p> 
        </div>
    </div>
    <div class="btns mb-5">
        <%if(currUser && currUser._id.equals(listing.owner._id)) { %>
            <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark col-1 offset-2">Edit
            </a>
            <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                <button class="btn offset-2 del-btn">Delete</button>
            </form>
        <% } %>
    </div>

    <!-- Review Section -->
     
    <div class="col-8 offset-2 mb-3">
        <%if(currUser){%>
        <hr>
        <h4>Leave a Review</h4>
        <form action="/listings/<%=listing._id%>/reviews" method="post" novalidate class="needs-validation">
            <div class="rating mt-3">
                <input type="radio" name="review[rating]" id="star5" value="5"><label for="star5">★</label>
                <input type="radio" name="review[rating]" id="star4" value="4"><label for="star4">★</label>
                <input type="radio" name="review[rating]" id="star3" value="3"><label for="star3">★</label>
                <input type="radio" name="review[rating]" id="star2" value="2"><label for="star2">★</label>
                <input type="radio" name="review[rating]" id="star1" value="1" checked><label for="star1">★</label>
            </div>
            <div class="mt-3">
                <label for="comment" class="form-label">Comment</label><br>
                <textarea name="review[comment]" id="comment" rows="5" cols="" class="form-control" required placeholder="Write comment : "></textarea>
                <div class="invalid-feedback">Please add some comments for review</div>
            </div>
            <button class=" btn btn-outline-dark mt-3">Submit</button>
        </form>
        <% } %>

        <br>
        <hr>
        <br>
        <%if(listing.reviews.length > 0 ){%>
        <h4>All Reviews : </h4>
        <div class="row mt-3">
            <% for (let review of listing.reviews) { %>
                <div class="card col-5 mt-4 ms-4 p-2 me-4 mb-3">
                    <div class="card-body">
                        <!-- Username + Stars -->
                        <div class="d-flex align-items-start">
                            <div class="username me-3">
                                <i class="bi bi-person-circle me-1"></i>
                                <strong><%= review.author.username %></strong>
                            </div>
                            <div class="stars ms-auto">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <% if (i <= review.rating) { %>
                                        <span class="star filled">★</span>
                                    <% } else { %>
                                        <span class="star">★</span>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>

                        <!-- Comment -->
                        <p class="card-text mt-2"><%= review.comment %></p>
                        
                        <!-- Delete button -->
                        <%if(review.author.equals(currUser)){%>
                            <form method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                                <button class="btn btn-outline-dark">Delete</button>
                            </form>
                        <%}%>
                    </div>
                </div>
            <% } %>
        </div>
        <%}%>
    </div>

    <!-- 🌍 MAP SECTION -->
  <div class="col-6 offset-2">
    <h3>Where you'll be</h3>
      <div id="map"></div>
  </div>

</div>
<script src="/javascript/map.js"></script>